<view class="category-container">
  <view class="category-header" style="display: flex; justify-content: space-between; align-items: center; padding: 20rpx; background: #f8f; border-bottom: 1rpx solid #ddd;">
    <view style="display: flex; align-items: center;">
      <text class="header-title" style="font-weight: bold; font-size: 32rpx;">商品分类</text>
      <view wx:if="{{isAdminMode}}" bindtap="handleAddSubCategory" style="margin-left: 20rpx; font-size: 24rpx; color: #07c160; background: #e8fcf0; padding: 6rpx 16rpx; border-radius: 10rpx; border: 1rpx solid #07c160;">
        + 添加子类
      </view>
    </view>
    <view class="admin-toggle" wx:if="{{canAdmin}}" bindtap="toggleAdminMode" style="font-size: 24rpx; color: #666; background: #eee; padding: 10rpx 20rpx; border-radius: 30rpx;">
      {{isAdminMode ? '✅ 编辑中' : '⚙️ 管理'}}
    </view>
  </view>
  <view class="category-main">
    <!-- 左侧大分类列表 -->
    <scroll-view class="category-left" scroll-y>
      <view
        class="category-item {{selectedCategory && selectedCategory.id === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="onCategoryTap"
        data-index="{{index}}"
      >
        <view style="display: flex; align-items: center; position: relative;">
          <image class="category-icon" src="{{item.icon}}" mode="aspectFit" style="width: 40rpx; height: 40rpx; margin-right: 10rpx;"></image>
          <text class="category-name">{{item.name}}</text>
          <text wx:if="{{isAdminMode}}" catchtap="confirmDeleteIcon" data-id="{{item.id}}" data-name="{{item.name}}" style="color: red; margin-left: 10rpx; font-size: 20rpx;">×</text>
        </view>
      </view>
    </scroll-view>

    <!-- 右侧展示区 -->
    <view class="category-right">
      <view class="sub-category-placeholder" wx:if="{{!selectedCategory}}">
        <text class="placeholder-text">请选择左侧分类</text>
      </view>

      <view class="sub-category-content" wx:else>
        <!-- 子类列表：仅在未选中具体子类时显示 -->
        <view class="sub-category-list" wx:if="{{!showProducts}}">
          <view class="section-title">—— {{selectedCategory.name}} 子类 ——</view>
          <view class="sub-grid">
            <view class="sub-item {{selectedSubCategory === sub ? 'active' : ''}}" wx:for="{{subCategories}}" wx:for-item="sub" wx:key="*this" bindtap="onSubCategoryTap" data-name="{{sub}}">
              {{sub}}
              <text wx:if="{{isAdminMode}}" catchtap="confirmDeleteSubCategory" data-name="{{sub}}" style="color: red; margin-left: 10rpx; font-size: 24rpx; padding: 5rpx; z-index: 10;">×</text>
            </view>
          </view>
        </view>

        <!-- 产品列表：选中子类后显示 -->
        <view class="product-display" wx:else>
          <view class="display-header">
            <text class="back-btn" bindtap="onBackToSub">← 返回子类</text>
            <text class="display-title">{{selectedSubCategory}} 商品</text>
          </view>
          <scroll-view scroll-y class="product-scroll">
            <view class="product-grid">
              <view class="product-card" wx:for="{{products}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
                <image src="{{item.img}}" mode="aspectFill" class="product-img"></image>
                <text class="product-name">{{item.name}}</text>
                <text class="product-price">￥{{item.price}}</text>
              </view>
            </view>
            <view class="no-products" wx:if="{{products.length === 0}}">
              暂无相关商品
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>

  <!-- 编辑图标弹窗 -->
  <view class="modal-mask" wx:if="{{showEdit}}" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 100;">
    <view class="modal-content" style="background: white; width: 80%; border-radius: 20rpx; padding: 40rpx;">
      <text class="modal-title" style="display: block; font-weight: bold; margin-bottom: 30rpx; text-align: center;">更换分类图标URL</text>
      <input class="modal-input" style="border: 1rpx solid #ddd; padding: 20rpx; border-radius: 10rpx; margin-bottom: 30rpx;" placeholder="请输入图片URL链接" value="{{editingUrl}}" bindinput="onInputUrl" />
      <view style="display: flex; justify-content: space-around;">
        <button size="mini" bindtap="closeEditModal">取消</button>
        <button size="mini" type="primary" bindtap="saveIconUrl">保存</button>
      </view>
    </view>
  </view>

  <custom-tabbar active="1" />
</view>
