<view class="container">
  <view class="cart-empty" wx:if="{{cartItems.length === 0}}">
    <text>购物车空空如也</text>
    <button class="btn-primary" bindtap="goHome">去购物</button>
  </view>

  <view class="cart-list" wx:else>
    <view class="select-all-header">
      <view class="checkbox-wrapper" bindtap="toggleSelectAll" data-value="{{!selectAll}}">
        <checkbox checked="{{selectAll}}" color="#ff4400" />
      </view>
      <text>全选</text>
    </view>

    <view class="cart-item card" wx:for="{{cartItems}}" wx:key="name">
      <view class="cart-item-left">
        <view class="checkbox-wrapper" bindtap="toggleSelect" data-index="{{index}}" data-value="{{!item.selected}}">
          <checkbox checked="{{item.selected}}" color="#ff4400" />
        </view>
        <view class="item-info">
          <text class="name">{{item.name}}</text>
          <text class="price">￥{{item.price}}</text>
        </view>
      </view>

      <view class="cart-item-right">
        <view class="stepper">
          <view class="step-btn minus" bindtap="minusCount" data-index="{{index}}">-</view>
          <text class="step-num">{{item.count}}</text>
          <view class="step-btn plus" bindtap="plusCount" data-index="{{index}}">+</view>
        </view>
        <view class="delete-btn" bindtap="deleteItem" data-id="{{item.id}}">🗑️</view>
      </view>
    </view>

    <view class="footer-bar">
      <view class="total-section">
        <text>合计: <text class="total-price">￥{{totalPrice}}</text></text>
      </view>
      <button class="btn-buy" bindtap="checkout">结算</button>
    </view>
    </view>
  <custom-tabbar active="2" />
</view>
