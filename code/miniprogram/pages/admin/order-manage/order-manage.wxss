.admin-container { padding: 30rpx; background: #f5f5f5; min-height: 100vh; }
.page-header { margin-bottom: 30rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #333; }
.order-list { display: flex; flex-direction: column; gap: 20rpx; }
.order-card { background: #fff; padding: 30rpx; border-radius: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.order-main { display: flex; justify-content: space-between; align-items: flex-start; }
.order-info { display: flex; flex-direction: column; gap: 10rpx; flex: 1; }
.order-id { font-size: 24rpx; color: #999; }
.order-customer { font-size: 28rpx; color: #666; }
.order-product { font-size: 30rpx; font-weight: bold; color: #333; }
.order-amount { font-size: 28rpx; color: #E4393C; font-weight: bold; }

.status-tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 8rpx; white-space: nowrap; }
.status-ordered { background: #E8F5E9; color: #4CAF50; }
.status-applying { background: #FFF3E0; color: #FF9800; }
.status-returned { background: #FFEBEE; color: #F44336; }

.order-actions { display: flex; gap: 20rpx; margin-top: 30rpx; border-top: 1rpx solid #eee; padding-top: 20rpx; }
.btn-approve { flex: 1; font-size: 26rpx; background: #4CAF50; color: #fff; border-radius: 10rpx; }
.btn-reject { flex: 1; font-size: 26rpx; background: #f44336; color: #fff; border-radius: 10rpx; }
