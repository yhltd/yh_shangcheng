<view class="admin-container">
  <view class="admin-header">
    <text class="title">商家管理后台</text>
    <view class="back-btn" bindtap="goBack">返回商城</view>
  </view>

  <view class="admin-grid">
    <view class="admin-card" wx:for="{{modules}}" wx:key="id" bindtap="onNavigate" data-path="{{item.path}}">
      <text class="admin-icon">{{item.icon}}</text>
      <text class="admin-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 新增：管理商家配置入口按钮 -->
  <view class="store-manage-section">
    <button class="manage-store-btn" bindtap="openStoreModal">⚙️ 配置店铺门户 (图片/欢迎语)</button>
  </view>

  <!-- 新增：商家配置弹窗 -->
  <view class="modal-mask" wx:if="{{showStoreModal}}">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">独立商家门户配置</text>
        <text class="close-btn" bindtap="closeStoreModal">×</text>
      </view>

      <view class="modal-body">
        <view class="config-item">
          <text class="config-label">店铺欢迎语</text>
          <input class="config-input" placeholder="例如：欢迎来到我的店铺" value="{{storeConfig.welcomeText}}" bindinput="bindInputWelcome" />
        </view>

        <view class="config-item">
          <text class="config-label">店铺门户图片</text>
          <view class="banner-upload-box">
            <image src="{{storeConfig.bannerUrl}}" mode="aspectFill" class="banner-preview" wx:if="{{storeConfig.bannerUrl}}" />
            <view class="upload-placeholder" bindtap="uploadStoreBanner" wx:if="{{!storeConfig.bannerUrl}}">
              <text class="upload-icon">📷</text>
              <text>点击上传封面图</text>
            </view>
            <view class="upload-overlay" bindtap="uploadStoreBanner" wx:if="{{storeConfig.bannerUrl}}">
              <text>更换图片</text>
            </view>
            <view class="delete-banner-btn" bindtap="deleteStoreBanner" wx:if="{{storeConfig.bannerUrl}}">🗑️</view>
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="save-btn" bindtap="saveStoreConfig">保存配置</button>
      </view>
    </view>
  </view>
</view>
