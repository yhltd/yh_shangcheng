<view class="tabbar">
  <view
    class="tabbar-item {{active === 0 ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="0"
  >
    <image src="/images/Tab/tabbar-home{{active === 0 ? '-active' : ''}}.png" class="tabbar-icon" />
    <text class="tabbar-text">首页</text>
  </view>
  <view
    class="tabbar-item {{active === 1 ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="1"
  >
    <image src="/images/Tab/tabbar-category{{active === 1 ? '-active' : ''}}.png" class="tabbar-icon" />
    <text class="tabbar-text">分类</text>
  </view>
  <view
    class="tabbar-item {{active === 2 ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="2"
  >
    <image src="/images/Tab/tabbar-cart{{active === 2 ? '-active' : ''}}.png" class="tabbar-icon" />
    <text class="tabbar-text">购物车</text>
  </view>
  <view
    class="tabbar-item {{active === 3 ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="3"
  >
    <image src="/images/Tab/tabbar-user{{active === 3 ? '-active' : ''}}.png" class="tabbar-icon" />
    <text class="tabbar-text">我的</text>
  </view>
</view>
